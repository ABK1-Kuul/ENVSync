{
  "name": "envsync-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "bundle": "pnpm --filter envsync run bundle",
    "stage": "pnpm --filter envsync run stage"
  },
  "devDependencies": {
    "@envsync-internal/core": "workspace:*",
    "@envsync-internal/parser-next": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0"
}
